# En-têtes HTTP (ignorés par GitHub Pages ; utiles si le jeu est un jour publié sur Cloudflare Pages).
# Le service worker et la page doivent toujours être revérifiés : c'est ainsi qu'une nouvelle version arrive.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
# Fichiers à empreinte : cache permanent.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
